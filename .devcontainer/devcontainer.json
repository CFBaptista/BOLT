{
    "name": "BOLT Development Container",
    "image": "ghcr.io/cfbaptista/bolt-dev:0.5.0",
    "customizations": {
        "vscode": {
            "extensions": [
                "christian-kohler.path-intellisense",
                "eamodio.gitlens",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "llvm-vs-code-extensions.vscode-clangd",
                "redhat.vscode-yaml",
                "samubarb.vscode-doxyfile",
                "stevebushresearch.buildoutputcolorizer",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "remoteUser": "ubuntu",
    "updateRemoteUserUID": true
}
