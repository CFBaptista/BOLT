option(BUILD_DOCS "Build documentation" OFF)
option(ENABLE_COVERAGE "Enable code coverage instrumentation" OFF)

set(BOLT_APPLICATION_DIRECTORY ${CMAKE_SOURCE_DIR}/apps/bolt)
set(BOLT_SOURCE_DIRECTORY ${CMAKE_SOURCE_DIR}/src/bolt)

if (NOT DEFINED LOG_LEVEL)
    if (CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(DEFAULT_LOG_LEVEL "DEBUG")
    elseif (CMAKE_BUILD_TYPE STREQUAL "Release")
        set(DEFAULT_LOG_LEVEL "INFO")
    elseif (CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
        set(DEFAULT_LOG_LEVEL "DEBUG")
    else()
        set(DEFAULT_LOG_LEVEL "INFO")
    endif()
    set(LOG_LEVEL ${DEFAULT_LOG_LEVEL} CACHE STRING "Set the log level for BOLT applications and libraries (i.e. TRACE_L3, TRACE_L2, TRACE_L1, DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL).")
endif()

if (LOG_LEVEL STREQUAL "TRACE_L3")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_TRACE_L3")
elseif (LOG_LEVEL STREQUAL "TRACE_L2")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_TRACE_L2")
elseif (LOG_LEVEL STREQUAL "TRACE_L1")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_TRACE_L1")
elseif (LOG_LEVEL STREQUAL "DEBUG")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_DEBUG")
elseif (LOG_LEVEL STREQUAL "INFO")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_INFO")
elseif (LOG_LEVEL STREQUAL "NOTICE")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_NOTICE")
elseif (LOG_LEVEL STREQUAL "WARNING")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_WARNING")
elseif (LOG_LEVEL STREQUAL "ERROR")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_ERROR")
elseif (LOG_LEVEL STREQUAL "CRITICAL")
    set(QUILL_LOG_LEVEL "QUILL_COMPILE_ACTIVE_LOG_LEVEL_CRITICAL")
else()
    message(FATAL_ERROR "Invalid log level: ${LOG_LEVEL}. Valid options are: TRACE_L3, TRACE_L2, TRACE_L1, DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL")
endif()
